# Planner behavior: auto (Groq -> Gemini -> offline), groq, gemini, or offline.
PLANNER_PROVIDER=auto

# Optional online planners. Do not commit real values.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local demo settings.
DATABASE_PATH=data/taskworker.db
DEMO_TRANSIENT_FAILURE=true
